{
  "name": "@rahal/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "format": "prisma format",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "pnpm build && node dist/src/seed.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('generated',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "prisma validate && prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "7.9.0",
    "typescript": "^5.9.3"
  }
}
