generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  CUSTOMER
  SALES
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BLOCKED
  ARCHIVED
}

enum VerificationPurpose {
  VERIFY_PHONE
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum VehicleStatus {
  AVAILABLE
  PENDING_REQUEST
  CONFIRMED_BOOKING
  RENTED
  MAINTENANCE
  MANUALLY_BLOCKED
  OVERDUE
  INACTIVE
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum BookingStatus {
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingOperationType {
  DELIVERY
  RETURN
}

enum AlternativeOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum ContractStatus {
  DRAFT
  READY_FOR_SIGNATURE
  SIGNED
  VOIDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DriverPolicy {
  OPTIONAL
  MANDATORY
  UNAVAILABLE
}

enum DriverChargeType {
  PER_DAY
  PER_TRIP
}

enum ReservationStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  PRE_APPROVED
  ALTERNATIVE_OFFERED
  REJECTED
  EXPIRED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DocumentType {
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  DRIVING_LICENSE_FRONT
  DRIVING_LICENSE_BACK
  PASSPORT
  SIGNED_CONTRACT
  DEPOSIT_RECEIPT
  OTHER
}

enum DocumentStatus {
  UPLOADING
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  DELETED
}

enum CustomerCategory {
  EGYPTIAN
  FOREIGN
}

enum VehicleBlockType {
  MAINTENANCE
  MANUAL_BLOCK
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StaffMfaChallengeKind {
  ENROLL
  VERIFY
}

model User {
  id                        String                   @id @default(cuid())
  email                     String                   @unique
  phone                     String                   @unique
  passwordHash              String
  fullNameAr                String?
  fullNameEn                String
  systemRole                SystemRole               @default(CUSTOMER)
  status                    UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt           DateTime?
  phoneVerifiedAt           DateTime?
  dateOfBirth               DateTime?
  nationality               String?
  address                   String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  preferredLocale           String                   @default("ar")
  mustChangePassword        Boolean                  @default(false)
  temporaryPasswordIssuedAt DateTime?
  staffRoleId               String?
  staffRole                 StaffRole?               @relation(fields: [staffRoleId], references: [id])
  reservations              Reservation[]            @relation("CustomerReservations")
  assignedReservations      Reservation[]            @relation("AssignedSales")
  verificationCodes         VerificationCode[]
  sessions                  Session[]
  devices                   Device[]
  permissionOverrides       UserPermissionOverride[]
  notificationPreference    NotificationPreference?
  pushSubscriptions         PushSubscription[]
  notifications             Notification[]
  auditEntries              AuditLog[]               @relation("AuditActor")
  internalNotes             InternalNote[]           @relation("InternalNoteAuthor")
  customerMessages          CustomerMessage[]        @relation("CustomerMessageSender")
  documentAccesses          DocumentAccessLog[]      @relation("DocumentAccessActor")
  alternativeOffers         AlternativeOffer[]       @relation("AlternativeOfferCreator")
  contractsRecorded         Contract[]               @relation("ContractRecorder")
  bookingOperations         BookingOperation[]       @relation("BookingOperationActor")
  bookings                  Booking[]                @relation("CustomerBookings")
  reviews                   Review[]
  reviewsModerated          Review[]                 @relation("ReviewModerator")
  staffMfaCredential        StaffMfaCredential?
  staffLoginChallenges      StaffLoginChallenge[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([systemRole, status])
}

model StaffMfaCredential {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretCiphertext String
  enabledAt        DateTime
  lastUsedCounter  BigInt?
  recoveryCodes    StaffMfaRecoveryCode[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([enabledAt])
}

model StaffMfaRecoveryCode {
  id           String             @id @default(cuid())
  credentialId String
  credential   StaffMfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  codeHash     String             @unique
  usedAt       DateTime?
  createdAt    DateTime           @default(now())

  @@index([credentialId, usedAt])
}

model StaffLoginChallenge {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String                @unique
  kind             StaffMfaChallengeKind
  secretCiphertext String?
  attempts         Int                   @default(0)
  expiresAt        DateTime
  usedAt           DateTime?
  ipHash           String?
  createdAt        DateTime              @default(now())

  @@index([userId, expiresAt])
}

model Session {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String        @unique
  status           SessionStatus @default(ACTIVE)
  mfaVerifiedAt    DateTime?
  ipHash           String?
  userAgent        String?
  expiresAt        DateTime
  lastSeenAt       DateTime      @default(now())
  revokedAt        DateTime?
  createdAt        DateTime      @default(now())

  @@index([userId, status, expiresAt])
}

model Device {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprintHash String
  label           String?
  platform        String?
  trusted         Boolean  @default(false)
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, fingerprintHash])
  @@index([userId, trusted])
}

model VerificationCode {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   VerificationPurpose
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now())

  @@index([userId, purpose, expiresAt])
}

model StaffRole {
  id          String                @id @default(cuid())
  name        String                @unique
  description String?
  isSystem    Boolean               @default(false)
  users       User[]
  permissions StaffRolePermission[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model Permission {
  id          String                   @id @default(cuid())
  key         String                   @unique
  category    String
  description String
  isCritical  Boolean                  @default(false)
  roles       StaffRolePermission[]
  overrides   UserPermissionOverride[]
}

model StaffRolePermission {
  staffRoleId  String
  permissionId String
  staffRole    StaffRole  @relation(fields: [staffRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([staffRoleId, permissionId])
}

model UserPermissionOverride {
  userId       String
  permissionId String
  allowed      Boolean
  reason       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Branch {
  id              String          @id @default(cuid())
  nameAr          String
  nameEn          String
  addressAr       String
  addressEn       String?
  latitude        Decimal?        @db.Decimal(10, 7)
  longitude       Decimal?        @db.Decimal(10, 7)
  phones          Json
  whatsappNumbers Json
  workingHours    Json
  active          Boolean         @default(true)
  vehicles        Vehicle[]
  reservations    Reservation[]
  bookings        Booking[]
  settings        BranchSetting[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model BranchSetting {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, key])
}

model Vehicle {
  id                     String               @id @default(cuid())
  branchId               String
  branch                 Branch               @relation(fields: [branchId], references: [id])
  slug                   String               @unique
  nameAr                 String
  nameEn                 String
  descriptionAr          String?
  descriptionEn          String?
  make                   String
  model                  String
  year                   Int
  registrationNumber     String               @unique
  category               String
  transmission           String
  fuelType               String
  seats                  Int
  luggage                Int?
  doors                  Int?
  status                 VehicleStatus        @default(AVAILABLE)
  dailyRate              Decimal              @db.Decimal(12, 2)
  weeklyRate             Decimal?             @db.Decimal(12, 2)
  minimumRentalDays      Int                  @default(1)
  driverPolicy           DriverPolicy         @default(OPTIONAL)
  driverChargeType       DriverChargeType?
  driverCharge           Decimal?             @db.Decimal(12, 2)
  driverIncludedHours    Int?
  driverExtraHourRate    Decimal?             @db.Decimal(12, 2)
  mileageAllowancePerDay Int?
  extraKilometreRate     Decimal?             @db.Decimal(12, 2)
  depositAmount          Decimal?             @db.Decimal(12, 2)
  insuranceInfoAr        String?
  insuranceInfoEn        String?
  fuelPolicyAr           String?
  fuelPolicyEn           String?
  active                 Boolean              @default(true)
  featured               Boolean              @default(false)
  archivedAt             DateTime?
  images                 VehicleImage[]
  translations           VehicleTranslation[]
  rateRules              VehicleRateRule[]
  reservations           Reservation[]
  bookings               Booking[]
  alternativeOffers      AlternativeOffer[]
  blocks                 VehicleBlock[]
  reviews                Review[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([branchId, status, active])
  @@index([category, dailyRate])
}

model VehicleTranslation {
  id            String  @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  locale        String
  name          String
  description   String?
  insuranceInfo String?
  fuelPolicy    String?

  @@unique([vehicleId, locale])
}

model VehicleRateRule {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  name       String
  startsAt   DateTime
  endsAt     DateTime
  dailyRate  Decimal  @db.Decimal(12, 2)
  weeklyRate Decimal? @db.Decimal(12, 2)
  priority   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vehicleId, active, startsAt, endsAt])
}

model VehicleImage {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  altAr      String?
  altEn      String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([vehicleId, sortOrder])
}

model VehicleBlock {
  id        String           @id @default(cuid())
  vehicleId String
  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      VehicleBlockType
  startsAt  DateTime
  endsAt    DateTime
  reason    String
  createdBy String
  createdAt DateTime         @default(now())

  @@index([vehicleId, startsAt, endsAt])
}

model Reservation {
  id                            String                @id @default(cuid())
  reference                     String                @unique
  customerId                    String
  customer                      User                  @relation("CustomerReservations", fields: [customerId], references: [id])
  assignedSalesId               String?
  assignedSales                 User?                 @relation("AssignedSales", fields: [assignedSalesId], references: [id])
  vehicleId                     String
  vehicle                       Vehicle               @relation(fields: [vehicleId], references: [id])
  branchId                      String
  branch                        Branch                @relation(fields: [branchId], references: [id])
  status                        ReservationStatus     @default(DRAFT)
  pickupAt                      DateTime
  returnAt                      DateTime
  driverRequested               Boolean               @default(false)
  vehicleRateSnapshot           Decimal               @db.Decimal(12, 2)
  driverRateSnapshot            Decimal?              @db.Decimal(12, 2)
  estimatedTotal                Decimal               @db.Decimal(12, 2)
  finalTotal                    Decimal?              @db.Decimal(12, 2)
  customerNotes                 String?
  customerNameSnapshot          String?
  customerEmailSnapshot         String?
  customerPhoneSnapshot         String?
  nationalitySnapshot           String?
  customerCategorySnapshot      CustomerCategory?
  addressSnapshot               String?
  emergencyContactNameSnapshot  String?
  emergencyContactPhoneSnapshot String?
  customerDetailsCompletedAt    DateTime?
  termsVersion                  String?
  termsAcceptedAt               DateTime?
  privacyConsentAt              DateTime?
  documentConsentAt             DateTime?
  operationalConsentAt          DateTime?
  marketingConsentAt            DateTime?
  submittedAt                   DateTime?
  preApprovalExpiresAt          DateTime?
  branchAttendedAt              DateTime?
  confirmedAt                   DateTime?
  deliveredAt                   DateTime?
  returnedAt                    DateTime?
  completedAt                   DateTime?
  rejectionReason               String?
  cancellationReason            String?
  documents                     ReservationDocument[]
  events                        ReservationEvent[]
  alternativeOffers             AlternativeOffer[]
  internalNotes                 InternalNote[]
  customerMessages              CustomerMessage[]
  contracts                     Contract[]
  booking                       Booking?
  deposit                       Deposit?
  notifications                 Notification[]
  review                        Review?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  @@index([vehicleId, pickupAt, returnAt, status])
  @@index([customerId, createdAt])
  @@index([assignedSalesId, status])
}

model AlternativeOffer {
  id                 String                 @id @default(cuid())
  reservationId      String
  reservation        Reservation            @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle                @relation(fields: [vehicleId], references: [id])
  createdById        String
  createdBy          User                   @relation("AlternativeOfferCreator", fields: [createdById], references: [id])
  status             AlternativeOfferStatus @default(PENDING)
  proposedPickupAt   DateTime
  proposedReturnAt   DateTime
  dailyRateSnapshot  Decimal                @db.Decimal(12, 2)
  driverRateSnapshot Decimal?               @db.Decimal(12, 2)
  estimatedTotal     Decimal                @db.Decimal(12, 2)
  note               String?
  expiresAt          DateTime
  respondedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([reservationId, status, expiresAt])
}

model Booking {
  id            String                @id @default(cuid())
  reference     String                @unique
  reservationId String                @unique
  reservation   Reservation           @relation(fields: [reservationId], references: [id])
  customerId    String
  customer      User                  @relation("CustomerBookings", fields: [customerId], references: [id])
  vehicleId     String
  vehicle       Vehicle               @relation(fields: [vehicleId], references: [id])
  branchId      String
  branch        Branch                @relation(fields: [branchId], references: [id])
  status        BookingStatus         @default(CONFIRMED)
  pickupAt      DateTime
  returnAt      DateTime
  confirmedAt   DateTime              @default(now())
  activatedAt   DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  priceSnapshot BookingPriceSnapshot?
  contracts     Contract[]
  operations    BookingOperation[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([vehicleId, status, pickupAt, returnAt])
  @@index([customerId, createdAt])
}

model BookingOperation {
  id               String               @id @default(cuid())
  bookingId        String
  booking          Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type             BookingOperationType
  odometerKm       Int
  fuelLevelPercent Int
  conditionNote    String
  actorId          String
  actor            User                 @relation("BookingOperationActor", fields: [actorId], references: [id])
  recordedAt       DateTime             @default(now())

  @@unique([bookingId, type])
  @@index([actorId, recordedAt])
}

model BookingPriceSnapshot {
  id              String                     @id @default(cuid())
  bookingId       String                     @unique
  booking         Booking                    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  currency        String                     @default("EGP")
  rentalDays      Int
  vehicleSubtotal Decimal                    @db.Decimal(12, 2)
  driverSubtotal  Decimal                    @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal                    @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal                    @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal                    @db.Decimal(12, 2)
  items           BookingPriceSnapshotItem[]
  createdAt       DateTime                   @default(now())
}

model BookingPriceSnapshotItem {
  id          String               @id @default(cuid())
  snapshotId  String
  snapshot    BookingPriceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  code        String
  description String
  quantity    Decimal              @db.Decimal(12, 2)
  unitAmount  Decimal              @db.Decimal(12, 2)
  totalAmount Decimal              @db.Decimal(12, 2)
  sortOrder   Int                  @default(0)

  @@index([snapshotId, sortOrder])
}

model ReservationDocument {
  id              String              @id @default(cuid())
  reservationId   String
  reservation     Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  type            DocumentType
  status          DocumentStatus      @default(UPLOADED)
  storageKey      String
  originalName    String
  mimeType        String
  sizeBytes       Int
  expiresAt       DateTime?
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  accessLogs      DocumentAccessLog[]

  @@index([reservationId, type, status])
}

model DocumentRequirementRule {
  id                String           @id @default(cuid())
  key               String           @unique
  customerCategory  CustomerCategory
  documentType      DocumentType
  requiresSelfDrive Boolean          @default(false)
  labelAr           String
  labelEn           String
  allowedMimeTypes  String[]
  maxSizeBytes      Int              @default(8388608)
  active            Boolean          @default(true)
  sortOrder         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([customerCategory, active, sortOrder])
}

model DocumentAccessLog {
  id         String              @id @default(cuid())
  documentId String
  document   ReservationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User                @relation("DocumentAccessActor", fields: [actorId], references: [id])
  action     String
  reason     String
  ipHash     String?
  succeeded  Boolean             @default(true)
  createdAt  DateTime            @default(now())

  @@index([documentId, createdAt])
  @@index([actorId, createdAt])
}

model InternalNote {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation("InternalNoteAuthor", fields: [authorId], references: [id])
  body          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([reservationId, createdAt])
}

model CustomerMessage {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User        @relation("CustomerMessageSender", fields: [senderId], references: [id])
  body          String
  readAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([reservationId, createdAt])
}

model Contract {
  id            String         @id @default(cuid())
  reservationId String
  reservation   Reservation    @relation(fields: [reservationId], references: [id])
  bookingId     String?
  booking       Booking?       @relation(fields: [bookingId], references: [id])
  status        ContractStatus @default(DRAFT)
  version       Int            @default(1)
  storageKey    String?
  signedAt      DateTime?
  recordedById  String?
  recordedBy    User?          @relation("ContractRecorder", fields: [recordedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([reservationId, version])
  @@index([bookingId, status])
}

model ReservationEvent {
  id            String             @id @default(cuid())
  reservationId String
  reservation   Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  actorId       String?
  note          String?
  metadata      Json?
  createdAt     DateTime           @default(now())

  @@index([reservationId, createdAt])
}

model Deposit {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(12, 2)
  receiptNumber String      @unique
  recordedBy    String
  recordedAt    DateTime    @default(now())
  notes         String?
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  inAppEnabled     Boolean @default(true)
  pushEnabled      Boolean @default(true)
  emailEnabled     Boolean @default(true)
  whatsappEnabled  Boolean @default(true)
  marketingEnabled Boolean @default(false)
  quietHoursStart  String?
  quietHoursEnd    String?
}

model Notification {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation?           @relation(fields: [reservationId], references: [id])
  eventKey      String
  titleAr       String
  titleEn       String
  bodyAr        String
  bodyEn        String
  important     Boolean                @default(false)
  readAt        DateTime?
  archivedAt    DateTime?
  deliveries    NotificationDelivery[]
  createdAt     DateTime               @default(now())

  @@index([userId, readAt, createdAt])
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  notificationId String
  notification   Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  status         DeliveryStatus      @default(QUEUED)
  providerId     String?
  attempts       Int                 @default(0)
  lastError      String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, channel, createdAt])
}

model NotificationEvent {
  id            String       @id @default(cuid())
  eventKey      String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  eventKey  String
  channel   NotificationChannel
  locale    String
  subject   String?
  body      String
  active    Boolean             @default(true)
  version   Int                 @default(1)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([eventKey, channel, locale, version])
  @@index([eventKey, active])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  platform   String
  userAgent  String?
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, active])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])
  action       String
  entityType   String
  entityId     String?
  previousData Json?
  newData      Json?
  reason       String?
  ipHash       String?
  userAgent    String?
  succeeded    Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Review {
  id             String       @id @default(cuid())
  reservationId  String       @unique
  reservation    Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User         @relation(fields: [customerId], references: [id])
  vehicleId      String
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])
  rating         Int
  comment        String?
  status         ReviewStatus @default(PENDING)
  moderationNote String?
  moderatedAt    DateTime?
  moderatedById  String?
  moderatedBy    User?        @relation("ReviewModerator", fields: [moderatedById], references: [id])
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([vehicleId, status, approvedAt])
}

model ContentEntry {
  id           String               @id @default(cuid())
  key          String               @unique
  type         String
  status       ContentStatus        @default(DRAFT)
  translations ContentTranslation[]
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model ContentTranslation {
  id        String       @id @default(cuid())
  contentId String
  content   ContentEntry @relation(fields: [contentId], references: [id], onDelete: Cascade)
  locale    String
  title     String?
  body      Json

  @@unique([contentId, locale])
}

model PolicyVersion {
  id          String    @id @default(cuid())
  policyKey   String
  version     String
  locale      String
  title       String
  body        String
  effectiveAt DateTime
  retiredAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([policyKey, version, locale])
  @@index([policyKey, effectiveAt])
}
