{
  "name": "rahal-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @rahal/web --filter @rahal/api dev",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --workers=6",
    "test:e2e:interaction": "playwright test tests/e2e/interaction-audit.spec.ts tests/e2e/functional-interactions.spec.ts",
    "test:e2e:documents": "playwright test tests/e2e/document-security.spec.ts",
    "test:release": "playwright test tests/e2e/interaction-audit.spec.ts tests/e2e/functional-interactions.spec.ts tests/e2e/document-security.spec.ts tests/e2e/authenticated-release.spec.ts tests/e2e/authenticated-lifecycle.spec.ts",
    "test:e2e:report": "playwright show-report",
    "security:audit": "node scripts/audit-security-gate.mjs",
    "security:audit:test": "node --test scripts/audit-security-gate.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @rahal/database generate",
    "db:format": "pnpm --filter @rahal/database format",
    "db:migrate": "pnpm --filter @rahal/database migrate:deploy",
    "db:seed": "pnpm --filter @rahal/database seed",
    "data:cleanup:preview": "powershell -NoProfile -File scripts/cleanup-demo-data.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.55.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
